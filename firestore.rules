rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.admin == true);
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Chat log: users/{uid}/chats/{sessionLoginTimestamp} holds one doc per
    // login session, with a `messages` array of {role, type, text, ts} rows
    // appended as the conversation goes. Writes happen server-side only, from
    // the `chat` Cloud Function (admin SDK, bypasses these rules) — the
    // client never writes its own chat log, so it can't be tampered with.
    // The owning user may read their own history; users with a custom
    // `admin: true` auth claim may read anyone's, for the admin dashboard.
    match /users/{userId}/chats/{sessionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if false;
    }

    // No other client-facing collections yet — deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
