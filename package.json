    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
